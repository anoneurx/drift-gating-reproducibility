\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces Total time per reference by miss cost, using the measured per-reference times and mean miss ratios of the 80 non-stable test traces. Panel (a): bold marks the lowest total in each row; DA is never the lowest, and the last column gives its excess over the best policy. Panel (b): pairwise crossing miss costs; the DA/S3-FIFO interval is unstable because the miss-ratio difference is small. All values are point estimates; bootstrap intervals are in the text.}}{12}{table.9}\protected@file@percent }
\newlabel{tab:breakeven}{{IX}{12}{Total time per reference by miss cost, using the measured per-reference times and mean miss ratios of the 80 non-stable test traces. Panel (a): bold marks the lowest total in each row; DA is never the lowest, and the last column gives its excess over the best policy. Panel (b): pairwise crossing miss costs; the DA/S3-FIFO interval is unstable because the miss-ratio difference is small. All values are point estimates; bootstrap intervals are in the text}{table.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Total time per reference versus miss cost for CLOCK, S3-FIFO, ContShadow and DA, with the lower envelope of the three comparators (black dashed). CLOCK is cheapest below 0.216\,$\mu $s, S3-FIFO between 0.216 and 2.305\,$\mu $s, and ContShadow above 2.305\,$\mu $s; DA is never on the envelope, with a minimum excess of 3.27\,ns/reference at 2.305\,$\mu $s. The orange band is the measured minor-fault cost; the inset zooms the CLOCK/S3-FIFO crossing.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:breakeven}{{8}{12}{Total time per reference versus miss cost for CLOCK, S3-FIFO, ContShadow and DA, with the lower envelope of the three comparators (black dashed). CLOCK is cheapest below 0.216\,$\mu $s, S3-FIFO between 0.216 and 2.305\,$\mu $s, and ContShadow above 2.305\,$\mu $s; DA is never on the envelope, with a minimum excess of 3.27\,ns/reference at 2.305\,$\mu $s. The orange band is the measured minor-fault cost; the inset zooms the CLOCK/S3-FIFO crossing}{figure.8}{}}
